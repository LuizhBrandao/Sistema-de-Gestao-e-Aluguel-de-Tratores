@page "/alertas"
@using Microsoft.AspNetCore.SignalR.Client
@using TractorRental.BlazorFrontend.Models
@inject IHttpClientFactory ClientFactory
@implements IAsyncDisposable

<PageTitle>Alertas de Telemetria</PageTitle>

<div class="fade-in">
    <header class="mb-4">
        <h1 style="font-size: 1.8rem; margin: 0;">Alertas em Tempo Real</h1>
        <p class="text-muted" style="margin: 0;">Monitoramento de anomalias na frota</p>
    </header>

    <div class="mb-3">
        Status da Conexão: 
        <span class="badge @(isConnected ? "bg-success" : "bg-danger")">
            @(isConnected ? "Conectado" : "Desconectado")
        </span>
    </div>

    @if (!alertas.Any())
    {
        <div class="alert alert-info">Nenhum alerta recente.</div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var alerta in alertas)
            {
                <div class="card bg-dark text-white border-warning">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="fs-2">@(alerta.Temperatura > 110 ? "🚨" : "⚠️")</div>
                        <div class="flex-grow-1">
                            <h5 class="card-title mb-1">Trator #@alerta.TratorId</h5>
                            <p class="card-text text-muted mb-0">
                                @alerta.Mensagem 
                                @if (alerta.Temperatura.HasValue)
                                {
                                    <span>(Temp: @alerta.Temperatura.Value.ToString("F1")°C)</span>
                                }
                            </p>
                        </div>
                        <div class="text-muted small">@alerta.Timestamp.ToLocalTime().ToString("HH:mm:ss")</div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private HubConnection? hubConnection;
    private List<AlertaDto> alertas = new();
    private bool isConnected => hubConnection?.State == HubConnectionState.Connected;

    protected override async Task OnInitializedAsync()
    {
        var client = ClientFactory.CreateClient("api");

        hubConnection = new HubConnectionBuilder()
            .WithUrl(new Uri(client.BaseAddress!, "hubs/monitoramento"), options => 
            {
                // In Blazor Server, we must ensure SignalR uses the same Service Discovery configured via Aspire
                // But typically WithUrl with an absolute resolved URI from HttpClient works fine.
            })
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<dynamic>("ReceberAlerta", alertaDin =>
        {
            var alertaStr = System.Text.Json.JsonSerializer.Serialize(alertaDin);
            var alerta = System.Text.Json.JsonSerializer.Deserialize<AlertaDto>(alertaStr, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            
            if (alerta != null)
            {
                alerta.Timestamp = DateTime.UtcNow;
                InvokeAsync(() =>
                {
                    alertas.Insert(0, alerta);
                    if (alertas.Count > 15) alertas.RemoveAt(alertas.Count - 1);
                    StateHasChanged();
                });
            }
        });

        try
        {
            await hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao conectar no SignalR: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is null) return;
        await hubConnection.DisposeAsync();
    }
}

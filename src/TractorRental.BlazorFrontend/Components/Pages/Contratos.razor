@page "/contratos"
@using TractorRental.BlazorFrontend.Models
@inject HttpClient Http

<PageTitle>Contratos de Locação | TractorRental Pro</PageTitle>

<div class="fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 mb-1">Contratos de Locação</h1>
            <p class="text-muted mb-0">Gestão de locações em campo, faturamento horário e abertura de novos contratos</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-secondary-agro" @onclick="CarregarTudo" disabled="@carregando">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
            <button class="btn btn-primary-agro" @onclick="AbrirModalCadastro">
                <i class="bi bi-file-earmark-plus-fill"></i>
                <span>Novo Contrato</span>
            </button>
        </div>
    </div>

    <!-- Search and Filter Bar -->
    <div class="row g-2 mb-4">
        <div class="col-md-6 col-lg-4">
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" placeholder="Buscar por ID ou detalhes..." @bind="termoBusca" @bind:event="oninput" />
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <select class="form-select" @bind="filtroStatus">
                <option value="">Todos os Status</option>
                <option value="Ativo">Ativo</option>
                <option value="Finalizado">Finalizado</option>
            </select>
        </div>
    </div>

    @if (carregando && contratos.Count == 0)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Carregando...</span>
            </div>
            <p class="text-muted mt-3">Carregando contratos...</p>
        </div>
    }
    else
    {
        <div class="app-table-container">
            <div class="table-responsive">
                <table class="app-table">
                    <thead>
                        <tr>
                            <th>Identificador</th>
                            <th>Cliente</th>
                            <th>Equipamento (Trator)</th>
                            <th>Data de Início</th>
                            <th>Valor / Hora</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!ContratosFiltrados.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="bi bi-file-earmark-text fs-2 d-block mb-2"></i>
                                    Nenhum contrato encontrado.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var c in ContratosFiltrados)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-white font-monospace">#@c.Id.ToString().Substring(0, 8)</div>
                                        <div class="text-muted small">@c.Id.ToString()</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-white">@ObterNomeCliente(c.ClienteId)</div>
                                        <div class="text-muted small font-monospace">Cliente ID: @c.ClienteId.ToString().Substring(0, 8)...</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-white">@ObterNomeTrator(c.TratorId)</div>
                                        <div class="text-muted small font-monospace">Trator ID: @c.TratorId.ToString().Substring(0, 8)...</div>
                                    </td>
                                    <td>
                                        <div class="text-white">@c.DataInicio.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                        @if (c.DataFim.HasValue)
                                        {
                                            <div class="text-muted small">Término: @c.DataFim.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-bold text-success fs-6">@c.ValorHora.ToString("C") <span class="text-muted small fw-normal">/ hora</span></div>
                                    </td>
                                    <td>
                                        @if (c.StatusFormatado == "Ativo")
                                        {
                                            <span class="app-badge badge-success"><i class="bi bi-play-circle-fill"></i> Ativo</span>
                                        }
                                        else
                                        {
                                            <span class="app-badge badge-info"><i class="bi bi-check2-all"></i> Finalizado</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Modal de Abertura de Novo Contrato -->
    @if (modalAberto)
    {
        <div class="modal fade show d-block app-modal-backdrop" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content app-modal-content">
                    <div class="modal-header app-modal-header">
                        <h5 class="modal-title text-white d-flex align-items-center gap-2">
                            <i class="bi bi-file-earmark-plus-fill text-success"></i> Abrir Novo Contrato de Locação
                        </h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="FecharModal"></button>
                    </div>
                    <div class="modal-body p-4">
                        @if (!string.IsNullOrEmpty(erroForm))
                        {
                            <div class="alert alert-danger py-2 small mb-3">
                                <i class="bi bi-exclamation-octagon me-1"></i> @erroForm
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(sucessoForm))
                        {
                            <div class="alert alert-success py-2 small mb-3">
                                <i class="bi bi-check-circle me-1"></i> @sucessoForm
                            </div>
                        }

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Cliente Contratante *</label>
                                @if (clientes.Count == 0)
                                {
                                    <div class="alert alert-warning py-2 small">Nenhum cliente cadastrado. Cadastre um cliente primeiro.</div>
                                }
                                else
                                {
                                    <select class="form-select" @bind="form.ClienteId">
                                        <option value="">-- Selecione o Cliente --</option>
                                        @foreach (var cli in clientes)
                                        {
                                            <option value="@cli.Id">@cli.RazaoSocialOuNome (@cli.DocumentoNumero)</option>
                                        }
                                    </select>
                                }
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Trator Disponível (Operacional) *</label>
                                @if (!TratoresOperacionais.Any())
                                {
                                    <div class="alert alert-warning py-2 small">Não há tratores operacionais disponíveis no momento.</div>
                                }
                                else
                                {
                                    <select class="form-select" @bind="form.TratorId">
                                        <option value="">-- Selecione o Trator --</option>
                                        @foreach (var t in TratoresOperacionais)
                                        {
                                            <option value="@t.Id">@t.Marca @t.Modelo (Combustível: @t.NivelCombustivel.ToString("F0")%)</option>
                                        }
                                    </select>
                                }
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Valor por Hora de Operação (R$) *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-dark border-secondary text-muted">R$</span>
                                    <input type="number" step="0.50" class="form-control" placeholder="150.00" @bind="form.ValorHora" />
                                </div>
                                <div class="text-muted small mt-1">O faturamento será computado com base no horímetro e tempo decorrido.</div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer app-modal-footer">
                        <button type="button" class="btn btn-secondary-agro" @onclick="FecharModal">Cancelar</button>
                        <button type="button" class="btn btn-primary-agro" @onclick="SalvarContrato" disabled="@enviando">
                            @if (enviando)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Processando Abertura...</span>
                            }
                            else
                            {
                                <i class="bi bi-check2-circle"></i>
                                <span>Abrir Contrato</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<ContratoDto> contratos = new();
    private List<ClienteDto> clientes = new();
    private List<TratorDto> tratores = new();

    private bool carregando = true;
    private bool modalAberto = false;
    private bool enviando = false;
    private string erroForm = "";
    private string sucessoForm = "";
    private string termoBusca = "";
    private string filtroStatus = "";
    private CadastroContratoForm form = new();

    private IEnumerable<TratorDto> TratoresOperacionais =>
        tratores.Where(t => t.Status == "Operacional");

    private IEnumerable<ContratoDto> ContratosFiltrados =>
        contratos.Where(c =>
            (string.IsNullOrWhiteSpace(filtroStatus) || c.StatusFormatado.Equals(filtroStatus, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(termoBusca) ||
             c.Id.ToString().Contains(termoBusca, StringComparison.OrdinalIgnoreCase) ||
             c.ClienteId.ToString().Contains(termoBusca, StringComparison.OrdinalIgnoreCase) ||
             c.TratorId.ToString().Contains(termoBusca, StringComparison.OrdinalIgnoreCase))
        );

    protected override async Task OnInitializedAsync()
    {
        await CarregarTudo();
    }

    private async Task CarregarTudo()
    {
        carregando = true;
        try
        {
            var cTask = Http.GetFromJsonAsync<List<ContratoDto>>("api/contratos");
            var cliTask = Http.GetFromJsonAsync<List<ClienteDto>>("api/clientes");
            var tTask = Http.GetFromJsonAsync<List<TratorDto>>("api/tratores/dashboard");

            await Task.WhenAll(cTask, cliTask, tTask);

            if (cTask.Result != null) contratos = cTask.Result;
            if (cliTask.Result != null) clientes = cliTask.Result;
            if (tTask.Result != null) tratores = tTask.Result;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar dados de contratos: {ex.Message}");
        }
        finally
        {
            carregando = false;
        }
    }

    private string ObterNomeCliente(Guid clienteId)
    {
        var cli = clientes.FirstOrDefault(c => c.Id == clienteId);
        return cli != null ? cli.RazaoSocialOuNome : "Cliente " + clienteId.ToString().Substring(0, 8);
    }

    private string ObterNomeTrator(Guid tratorId)
    {
        var t = tratores.FirstOrDefault(tr => tr.Id == tratorId);
        return t != null ? $"{t.Marca} {t.Modelo}" : "Trator " + tratorId.ToString().Substring(0, 8);
    }

    private void AbrirModalCadastro()
    {
        form = new CadastroContratoForm
        {
            ClienteId = clientes.FirstOrDefault()?.Id,
            TratorId = TratoresOperacionais.FirstOrDefault()?.Id,
            ValorHora = 150.00m
        };
        erroForm = "";
        sucessoForm = "";
        modalAberto = true;
    }

    private void FecharModal()
    {
        modalAberto = false;
    }

    private async Task SalvarContrato()
    {
        erroForm = "";
        sucessoForm = "";

        if (!form.ClienteId.HasValue || form.ClienteId.Value == Guid.Empty ||
            !form.TratorId.HasValue || form.TratorId.Value == Guid.Empty ||
            !form.ValorHora.HasValue || form.ValorHora.Value <= 0)
        {
            erroForm = "Selecione o Cliente, o Trator Operacional e defina um Valor por Hora válido.";
            return;
        }

        enviando = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/contratos", new
            {
                clienteId = form.ClienteId.Value,
                tratorId = form.TratorId.Value,
                valorHora = form.ValorHora.Value
            });

            if (!response.IsSuccessStatusCode)
            {
                var erroText = await response.Content.ReadAsStringAsync();
                erroForm = $"Erro ao abrir contrato: {erroText}";
                return;
            }

            sucessoForm = "Contrato iniciado com sucesso! Trator atualizado para status 'Alugado' via evento de integração cross-BC.";
            await CarregarTudo();

            await Task.Delay(1400);
            modalAberto = false;
        }
        catch (Exception ex)
        {
            erroForm = $"Exceção: {ex.Message}";
        }
        finally
        {
            enviando = false;
        }
    }
}

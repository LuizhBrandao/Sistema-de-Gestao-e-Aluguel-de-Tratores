@page "/frota"
@using TractorRental.BlazorFrontend.Models
@inject HttpClient Http

<PageTitle>Frota de Tratores | TractorRental Pro</PageTitle>

<div class="fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 mb-1">Frota de Equipamentos</h1>
            <p class="text-muted mb-0">Gerenciamento, telemetria em tempo real e cadastro de tratores</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-secondary-agro" @onclick="CarregarTratores" disabled="@carregando">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
            <button class="btn btn-primary-agro" @onclick="AbrirModalCadastro">
                <i class="bi bi-plus-lg"></i>
                <span>Novo Trator</span>
            </button>
        </div>
    </div>

    <!-- Search & Filter Bar -->
    <div class="row g-2 mb-4">
        <div class="col-md-6 col-lg-4">
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" placeholder="Buscar por marca, modelo ou ID..." @bind="termoBusca" @bind:event="oninput" />
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <select class="form-select" @bind="filtroStatus">
                <option value="">Todos os Status</option>
                <option value="Operacional">Operacional</option>
                <option value="Alugado">Alugado</option>
                <option value="EmManutencao">Em Manutenção</option>
            </select>
        </div>
    </div>

    @if (carregando && tratores.Count == 0)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Carregando...</span>
            </div>
            <p class="text-muted mt-3">Carregando frota...</p>
        </div>
    }
    else
    {
        <div class="app-table-container">
            <div class="table-responsive">
                <table class="app-table">
                    <thead>
                        <tr>
                            <th>Identificação</th>
                            <th>Status</th>
                            <th>Nível Combustível</th>
                            <th>Temperatura</th>
                            <th>Pressão Pneus</th>
                            <th>RPM / Velocidade</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!TratoresFiltrados.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                    Nenhum trator encontrado com os filtros aplicados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var t in TratoresFiltrados)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fs-4">🚜</span>
                                            <div>
                                                <div class="fw-bold text-white">@t.Marca @t.Modelo</div>
                                                <div class="text-muted small">UUID: @t.Id.ToString()</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (t.Status == "Operacional")
                                        {
                                            <span class="app-badge badge-success"><i class="bi bi-check-circle-fill"></i> Operacional</span>
                                        }
                                        else if (t.Status == "Alugado")
                                        {
                                            <span class="app-badge badge-info"><i class="bi bi-clock-history"></i> Alugado</span>
                                        }
                                        else
                                        {
                                            <span class="app-badge badge-danger"><i class="bi bi-tools"></i> Manutenção</span>
                                        }
                                    </td>
                                    <td style="min-width: 140px;">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1 bg-dark" style="height: 6px;">
                                                <div class="progress-bar @(t.NivelCombustivel < 20 ? "bg-danger" : (t.NivelCombustivel < 40 ? "bg-warning" : "bg-success"))" 
                                                     style="width: @(Math.Clamp(t.NivelCombustivel, 0, 100))%;">
                                                </div>
                                            </div>
                                            <span class="small fw-semibold">@t.NivelCombustivel.ToString("F0")%</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="fw-semibold @(t.TemperaturaAtualMotor > 105 ? "text-danger" : "text-white")">
                                            @t.TemperaturaAtualMotor.ToString("F1") °C
                                            @if (t.TemperaturaAtualMotor > 105)
                                            {
                                                <i class="bi bi-exclamation-triangle-fill text-danger ms-1" title="Alta Temperatura!"></i>
                                            }
                                        </span>
                                    </td>
                                    <td>
                                        <span class="text-white">@t.PressaoAtualPneus.ToString("F1") PSI</span>
                                    </td>
                                    <td>
                                        <div class="text-white">@t.RotacaoMotor.ToString("F0") RPM</div>
                                        <div class="text-muted small">@t.Velocidade.ToString("F1") km/h</div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Modal de Cadastro de Trator -->
    @if (modalAberto)
    {
        <div class="modal fade show d-block app-modal-backdrop" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content app-modal-content">
                    <div class="modal-header app-modal-header">
                        <h5 class="modal-title text-white d-flex align-items-center gap-2">
                            <i class="bi bi-plus-circle text-success"></i> Cadastrar Novo Trator
                        </h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="FecharModal"></button>
                    </div>
                    <div class="modal-body p-4">
                        @if (!string.IsNullOrEmpty(erroForm))
                        {
                            <div class="alert alert-danger py-2 small mb-3">
                                <i class="bi bi-exclamation-octagon me-1"></i> @erroForm
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(sucessoForm))
                        {
                            <div class="alert alert-success py-2 small mb-3">
                                <i class="bi bi-check-circle me-1"></i> @sucessoForm
                            </div>
                        }

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Marca *</label>
                                <input class="form-control" placeholder="Ex: John Deere, Valtra, Massey" @bind="form.Marca" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Modelo *</label>
                                <input class="form-control" placeholder="Ex: 8R 370, A940" @bind="form.Modelo" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Ano de Fabricação *</label>
                                <input type="number" class="form-control" @bind="form.AnoFabricacao" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Potência (CV) *</label>
                                <input type="number" class="form-control" placeholder="Ex: 210" @bind="form.PotenciaCv" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Horímetro Inicial (h)</label>
                                <input type="number" step="0.1" class="form-control" @bind="form.HorimetroInicial" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Número de Série *</label>
                                <input class="form-control" placeholder="Ex: JD-8R-99882" @bind="form.NumeroSerie" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer app-modal-footer">
                        <button type="button" class="btn btn-secondary-agro" @onclick="FecharModal">Cancelar</button>
                        <button type="button" class="btn btn-primary-agro" @onclick="SalvarTrator" disabled="@enviando">
                            @if (enviando)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Cadastrando...</span>
                            }
                            else
                            {
                                <i class="bi bi-check2-circle"></i>
                                <span>Cadastrar Equipamento</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<TratorDto> tratores = new();
    private bool carregando = true;
    private bool modalAberto = false;
    private bool enviando = false;
    private string erroForm = "";
    private string sucessoForm = "";
    private string termoBusca = "";
    private string filtroStatus = "";
    private CadastroTratorForm form = new();

    private IEnumerable<TratorDto> TratoresFiltrados =>
        tratores.Where(t =>
            (string.IsNullOrWhiteSpace(filtroStatus) || t.Status.Equals(filtroStatus, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(termoBusca) ||
             t.Marca.Contains(termoBusca, StringComparison.OrdinalIgnoreCase) ||
             t.Modelo.Contains(termoBusca, StringComparison.OrdinalIgnoreCase) ||
             t.Id.ToString().Contains(termoBusca, StringComparison.OrdinalIgnoreCase))
        );

    protected override async Task OnInitializedAsync()
    {
        await CarregarTratores();
    }

    private async Task CarregarTratores()
    {
        carregando = true;
        try
        {
            var data = await Http.GetFromJsonAsync<List<TratorDto>>("api/tratores/dashboard");
            if (data != null) tratores = data;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar tratores: {ex.Message}");
        }
        finally
        {
            carregando = false;
        }
    }

    private void AbrirModalCadastro()
    {
        form = new CadastroTratorForm();
        erroForm = "";
        sucessoForm = "";
        modalAberto = true;
    }

    private void FecharModal()
    {
        modalAberto = false;
    }

    private async Task SalvarTrator()
    {
        erroForm = "";
        sucessoForm = "";

        if (string.IsNullOrWhiteSpace(form.Marca) || string.IsNullOrWhiteSpace(form.Modelo) || 
            !form.AnoFabricacao.HasValue || !form.PotenciaCv.HasValue || string.IsNullOrWhiteSpace(form.NumeroSerie))
        {
            erroForm = "Preencha todos os campos obrigatórios (*).";
            return;
        }

        enviando = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/tratores", new
            {
                marca = form.Marca,
                modelo = form.Modelo,
                anoFabricacao = form.AnoFabricacao.Value,
                potenciaCv = form.PotenciaCv.Value,
                horimetroInicial = form.HorimetroInicial ?? 0,
                numeroSerie = form.NumeroSerie
            });

            if (!response.IsSuccessStatusCode)
            {
                var erroText = await response.Content.ReadAsStringAsync();
                erroForm = $"Erro na API: {erroText}";
                return;
            }

            sucessoForm = "Trator registrado com sucesso no Bounded Context de Frota!";
            await CarregarTratores();

            await Task.Delay(1200);
            modalAberto = false;
        }
        catch (Exception ex)
        {
            erroForm = $"Exceção: {ex.Message}";
        }
        finally
        {
            enviando = false;
        }
    }
}

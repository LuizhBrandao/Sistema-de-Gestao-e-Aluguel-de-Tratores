@page "/"
@using TractorRental.BlazorFrontend.Models
@inject HttpClient Http

<PageTitle>Dashboard | TractorRental Pro</PageTitle>

<div class="fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 mb-1">Painel Geral de Operações</h1>
            <p class="text-muted mb-0">Visão consolidada da frota, contratos e telemetria</p>
        </div>
        <button class="btn btn-secondary-agro" @onclick="CarregarDados" disabled="@carregando">
            <i class="bi bi-arrow-clockwise @(carregando ? "spin" : "")"></i>
            <span>@(carregando ? "Atualizando..." : "Atualizar")</span>
        </button>
    </div>

    @if (carregando && tratores.Count == 0)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Carregando...</span>
            </div>
            <p class="text-muted mt-3">Carregando métricas do sistema...</p>
        </div>
    }
    else
    {
        <!-- KPI Cards Grid -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="metric-card">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="card-label">Total de Tratores</div>
                        <span class="card-icon">🚜</span>
                    </div>
                    <div class="card-value">@tratores.Count</div>
                    <div class="text-muted small">Equipamentos registrados</div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="metric-card">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="card-label">Operacionais</div>
                        <span class="card-icon">✅</span>
                    </div>
                    <div class="card-value text-success">@operacionais</div>
                    <div class="text-muted small">Prontos para locação</div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="metric-card">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="card-label">Alugados</div>
                        <span class="card-icon">📋</span>
                    </div>
                    <div class="card-value text-info">@alugados</div>
                    <div class="text-muted small">Em operação no campo</div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="metric-card">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="card-label">Em Manutenção</div>
                        <span class="card-icon">🔧</span>
                    </div>
                    <div class="card-value text-danger">@emManutencao</div>
                    <div class="text-muted small">Aguardando reparo</div>
                </div>
            </div>
        </div>

        <!-- Main Dashboard Details Grid -->
        <div class="row g-4">
            <!-- Left Side: Fleet Live Status -->
            <div class="col-lg-8">
                <div class="app-table-container">
                    <div class="d-flex justify-content-between align-items-center p-3 border-bottom border-secondary border-opacity-25">
                        <h2 class="h5 mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-speedometer2 text-success"></i>
                            <span>Status em Tempo Real da Frota</span>
                        </h2>
                        <a href="frota" class="btn btn-sm btn-secondary-agro">Ver Todos</a>
                    </div>
                    <div class="table-responsive">
                        <table class="app-table">
                            <thead>
                                <tr>
                                    <th>Equipamento</th>
                                    <th>Status</th>
                                    <th>Combustível</th>
                                    <th>Temperatura</th>
                                    <th>Velocidade</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (tratores.Count == 0)
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">Nenhum trator registrado.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var t in tratores.Take(6))
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-bold text-white">@t.Marca @t.Modelo</div>
                                                <div class="text-muted small">ID: @t.Id.ToString().Substring(0, 8)...</div>
                                            </td>
                                            <td>
                                                @if (t.Status == "Operacional")
                                                {
                                                    <span class="app-badge badge-success"><i class="bi bi-check-circle-fill"></i> Operacional</span>
                                                }
                                                else if (t.Status == "Alugado")
                                                {
                                                    <span class="app-badge badge-info"><i class="bi bi-clock-history"></i> Alugado</span>
                                                }
                                                else
                                                {
                                                    <span class="app-badge badge-danger"><i class="bi bi-tools"></i> Manutenção</span>
                                                }
                                            </td>
                                            <td style="min-width: 140px;">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="progress flex-grow-1 bg-dark" style="height: 6px;">
                                                        <div class="progress-bar @(t.NivelCombustivel < 20 ? "bg-danger" : (t.NivelCombustivel < 40 ? "bg-warning" : "bg-success"))" 
                                                             style="width: @(Math.Clamp(t.NivelCombustivel, 0, 100))%;">
                                                        </div>
                                                    </div>
                                                    <span class="small fw-semibold">@t.NivelCombustivel.ToString("F0")%</span>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="fw-semibold @(t.TemperaturaAtualMotor > 105 ? "text-danger" : "text-white")">
                                                    @t.TemperaturaAtualMotor.ToString("F1") °C
                                                </span>
                                            </td>
                                            <td>
                                                <span class="fw-semibold">@t.Velocidade.ToString("F1") km/h</span>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Right Side: Business & System Status -->
            <div class="col-lg-4">
                <div class="d-flex flex-column gap-3">
                    <div class="metric-card">
                        <h2 class="h6 text-muted text-uppercase mb-3">Resumo Comercial</h2>
                        
                        <div class="d-flex justify-content-between align-items-center p-3 rounded mb-2" style="background: rgba(255,255,255,0.03);">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-people text-info fs-5"></i>
                                <span>Clientes Cadastrados</span>
                            </div>
                            <span class="fs-5 fw-bold text-white">@totalClientes</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center p-3 rounded mb-2" style="background: rgba(255,255,255,0.03);">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-file-earmark-check text-success fs-5"></i>
                                <span>Contratos Ativos</span>
                            </div>
                            <span class="fs-5 fw-bold text-success">@contratosAtivos</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center p-3 rounded" style="background: rgba(255,255,255,0.03);">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-currency-dollar text-warning fs-5"></i>
                                <span>Faturamento/Hora Estimado</span>
                            </div>
                            <span class="fs-5 fw-bold text-warning">@faturamentoHoraEstimado.ToString("C")</span>
                        </div>
                    </div>

                    <div class="metric-card">
                        <h2 class="h6 text-muted text-uppercase mb-3">Conexão IoT & Backend</h2>
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <span class="status-dot"></span>
                            <div class="small">
                                <div class="fw-bold text-white">API Minimalista (.NET 10)</div>
                                <div class="text-muted">Serviços REST & CQRS operacionais</div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <span class="status-dot"></span>
                            <div class="small">
                                <div class="fw-bold text-white">Simulador IoT Worker & RabbitMQ</div>
                                <div class="text-muted">Processamento de telemetria ativo</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<TratorDto> tratores = new();
    private int operacionais;
    private int alugados;
    private int emManutencao;
    private int totalClientes;
    private int contratosAtivos;
    private decimal faturamentoHoraEstimado;
    private bool carregando = true;

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        carregando = true;
        try
        {
            var tratoresData = await Http.GetFromJsonAsync<List<TratorDto>>("api/tratores/dashboard");
            if (tratoresData != null)
            {
                tratores = tratoresData;
                operacionais = tratores.Count(t => t.Status == "Operacional");
                alugados = tratores.Count(t => t.Status == "Alugado");
                emManutencao = tratores.Count(t => t.Status == "EmManutencao");
            }

            var clientes = await Http.GetFromJsonAsync<List<ClienteDto>>("api/clientes");
            if (clientes != null)
            {
                totalClientes = clientes.Count;
            }

            var contratos = await Http.GetFromJsonAsync<List<ContratoDto>>("api/contratos");
            if (contratos != null)
            {
                contratosAtivos = contratos.Count(c => c.StatusFormatado == "Ativo");
                faturamentoHoraEstimado = contratos
                    .Where(c => c.StatusFormatado == "Ativo")
                    .Sum(c => c.ValorHora);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar dados do Dashboard: {ex.Message}");
        }
        finally
        {
            carregando = false;
        }
    }
}

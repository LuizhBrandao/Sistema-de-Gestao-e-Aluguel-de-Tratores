@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <header class="top-header">
            <div class="d-flex align-items-center gap-3">
                <span class="fw-bold text-white fs-6 d-none d-sm-inline">🚜 TractorRental Pro</span>
                <span class="system-badge">
                    <span class="status-dot"></span> Telemetria & API Ativa
                </span>
            </div>

            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center gap-2 text-white small">
                    <i class="bi bi-clock"></i>
                    <span>@DateTime.Now.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="user-pill d-flex align-items-center gap-2">
                    <div class="avatar-circle">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div class="d-none d-md-block text-start">
                        <div class="user-name">Central Operacional</div>
                        <div class="user-role">Gestor de Frota</div>
                    </div>
                </div>
            </div>
        </header>

        <article class="content px-4 py-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro não tratado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>
